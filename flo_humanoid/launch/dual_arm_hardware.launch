<launch>
  <include file="$(find flo_humanoid)/launch/read_write_arms.launch"/>

  <param name="robot_description" command="cat $(find flov2_robot_description)/urdf/flov2_robot_description.urdf" />

  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
        output="screen"/>
</launch>
