<launch>
  <arg name="arg_x" default="0.00" />
  <arg name="arg_y" default="0.00" />
  <arg name="arg_z" default="0.00" />
  <arg name="arg_R" default="0.00" />
  <arg name="arg_P" default="0.00" />
  <arg name="arg_Y" default="0.00" />
  
  <include file="$(find gazebo_ros)/launch/empty_world.launch" />
  
  <!-- Static transform publisher for base_link to base_footprint -->
  <node name="tf_footprint_base" pkg="tf" type="static_transform_publisher" args="0 0 0 0 0 0 base_link base_footprint 40" />
  
  <!-- Spawn main robot model with joints fixed -->
  <node name="spawn_flov2withhead" pkg="gazebo_ros" type="spawn_model" args="-file $(find flov2withhead)/urdf/flov2withhead.urdf -urdf -model flov2withhead -x $(arg arg_x) -y $(arg arg_y) -z $(arg arg_z) -Y $(arg arg_Y) -J joint1 0.0 -J joint2 0.0 -J joint3 0.0 -J joint4 0.0 -J joint5 0.0 -J joint6 0.0" output="screen" />
  
  <!-- Publish a message to /calibrated -->
  <node name="fake_joint_calibration" pkg="rostopic" type="rostopic" args="pub /calibrated std_msgs/Bool true" />
  
  <!-- Load and launch the joint trajectory controller -->
  <rosparam file="$(find flov2tag)/config/joint_trajectory_controller.yaml" command="load"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="joint_state_controller robot_arm_controller hand_ee_controller"/>
  
  <!-- Robot State Publisher for TF of each joint: publishes all the current states of the joint, then RViz can visualize -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen"/>
  
  <!-- Spawn AprilTag model -->
  <node name="spawn_apriltag" pkg="gazebo_ros" type="spawn_model" args="-sdf -file $(find flov2tag)/meshes/apriltag_model/model.sdf -model apriltag_model -x 1.0 -y 1.0 -z 0.5" />
  
  <!-- Spawn camera model -->
  <param name="camera_description" textfile="$(find camera)/urdf/camera.urdf"/>
  <node name="spawn_camera" pkg="gazebo_ros" type="spawn_model" args="-file $(find camera)/urdf/camera.urdf -urdf -model camera" output="screen" />
  
  <!-- Launch subscriber node for AprilTag detection -->
  <!-- <node name="subscriber_apriltag" pkg="test_moveit" type="subscriber_apriltag" output="screen" /> -->
</launch>
